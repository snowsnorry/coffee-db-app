# Coffee DB local configuration
#
# Copy this file to .env and replace placeholder values:
#   cp .env.example .env
#
# The root .env is loaded by the server, integration-test, and visual-test
# scripts. Existing shell, CI, or secret-manager variables take
# precedence. Never commit real credentials.

# PostgreSQL connection used by the catalogue API. On startup, the server
# creates missing catalogue tables and indexes. Use a pooled Neon URL for
# normal API traffic; its role must have permission to create these objects.
# Keep TLS certificate verification enabled for remote databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Optional direct (non-pooler) connection using the same database, schema, and
# role as DATABASE_URL.
# Set this when DATABASE_URL points to a transaction-mode pooler such as a
# pooled Neon endpoint. Startup uses a session advisory lock while creating
# indexes concurrently, so this connection must preserve database sessions.
# The shared role must own existing catalogue tables and have CREATE on the
# schema so the API retains access to objects created during startup.
DATABASE_SCHEMA_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

# Port used by `npm run dev:server`, `npm run dev:all`, and `npm start`.
# The Vite development proxy expects the default server port 3000.
PORT=3000

# Development-only direct PostgreSQL connection used by `npm run test:integration`.
# The test creates a uniquely named temporary schema and removes it afterward.
# Never point this value at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# URL of a running real-data preview used by `npm run test:visual`.
# Change this only when the preview is served on a different host or port.
CATALOG_PREVIEW_URL=http://localhost:3000
